# =========================================================
# Pixora AI Photo Studio - Environment Variables Template
# =========================================================
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env or .env.local to version control.

# InsForge Backend (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key
INSFORGE_API_KEY=your_insforge_service_role_key

# YouCam / Perfect Corp AI Engine API Key
YOUCAM_API_KEY=your_youcam_api_key

# Razorpay Payment Gateway (Test or Production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
